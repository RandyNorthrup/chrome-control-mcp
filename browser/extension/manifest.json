{
  "manifest_version": 3,
  "name": "Chrome Control MCP",
  "version": "1.0.0",
  "key": "",
  "description": "Lets an AI assistant view and control the active Chrome tab through the DevTools Protocol, with a visible agent cursor. Your own mouse and keyboard stay yours.",
  "minimum_chrome_version": "116",
  "permissions": [
    "nativeMessaging",
    "debugger",
    "tabs",
    "tabGroups",
    "contentSettings",
    "cookies",
    "downloads"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Chrome Control MCP"
  }
}
