{
  "manifest_version": 3,
  "name": "Chrome Control MCP",
  "version": "1.13.0",
  "key": "",
  "description": "Lets AI agents drive your real Chrome over MCP, in tabs of their own with a visible cursor. Your mouse and keyboard stay yours.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "116",
  "permissions": [
    "nativeMessaging",
    "debugger",
    "tabs",
    "tabGroups",
    "contentSettings",
    "cookies",
    "downloads",
    "offscreen",
    "alarms",
    "storage",
    "scripting",
    "webNavigation",
    "identity",
    "identity.email"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Chrome Control MCP",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
