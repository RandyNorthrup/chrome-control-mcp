{
  "name": "chrome-control-mcp",
  "displayName": "Chrome Control MCP",
  "description": "Let AI agents use your real Chrome: each in its own tabs and coloured group, beside you, and cleaned up when done. A local Model Context Protocol server for any MCP client.",
  "version": "1.9.0",
  "publisher": "RandyNorthrup",
  "license": "MIT",
  "author": "Randy Northrup",
  "engines": {
    "vscode": "^1.101.0",
    "node": ">=20.19"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "mcp",
    "model context protocol",
    "chrome",
    "browser automation",
    "ai agents",
    "multi-agent",
    "devtools",
    "tab groups",
    "file upload",
    "mcp server"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/RandyNorthrup/chrome-control-mcp.git",
    "directory": "vscode"
  },
  "bugs": {
    "url": "https://github.com/RandyNorthrup/chrome-control-mcp/issues"
  },
  "homepage": "https://github.com/RandyNorthrup/chrome-control-mcp#readme",
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "chrome-control-mcp",
        "label": "Chrome Control MCP"
      }
    ],
    "commands": [
      {
        "command": "chromeControlMcp.repair",
        "title": "Repair install",
        "category": "Chrome Control MCP"
      },
      {
        "command": "chromeControlMcp.openExtensionFolder",
        "title": "Show the Chrome extension folder to load",
        "category": "Chrome Control MCP"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -p . --watch",
    "lint": "tsc -p . --noEmit",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/vscode": "1.101.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.9.3"
  },
  "icon": "icon.png",
  "overrides": {
    "glob": "^14.0.2",
    "minimatch": "^11.0.1"
  },
  "galleryBanner": {
    "color": "#070a10",
    "theme": "dark"
  }
}
