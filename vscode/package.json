{
  "name": "chrome-control-mcp",
  "displayName": "Chrome Control MCP",
  "description": "Visible, precise Chrome control for AI assistants, as a Model Context Protocol server. Local by design.",
  "version": "1.5.2",
  "publisher": "RandyNorthrup",
  "license": "MIT",
  "author": "Randy Northrup",
  "engines": {
    "vscode": "^1.101.0",
    "node": ">=20.19"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "mcp",
    "chrome",
    "browser",
    "automation",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/RandyNorthrup/chrome-control-mcp.git",
    "directory": "vscode"
  },
  "bugs": {
    "url": "https://github.com/RandyNorthrup/chrome-control-mcp/issues"
  },
  "homepage": "https://github.com/RandyNorthrup/chrome-control-mcp#readme",
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "chrome-control-mcp",
        "label": "Chrome Control MCP"
      }
    ],
    "commands": [
      {
        "command": "chromeControlMcp.repair",
        "title": "Repair install",
        "category": "Chrome Control MCP"
      },
      {
        "command": "chromeControlMcp.openExtensionFolder",
        "title": "Show the Chrome extension folder to load",
        "category": "Chrome Control MCP"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -p . --watch",
    "lint": "tsc -p . --noEmit",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/vscode": "1.101.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.9.3"
  },
  "icon": "icon.png"
}
